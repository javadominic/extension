{
  "manifest_version": 3,
  "name": "Contextos",
  "version": "1.0.0",
  "description": "Smart bookmark memory assistant with AI. Save why you bookmarked something and never forget again.",
  "author": "Your Name",
  "homepage_url": "https://github.com/yourusername/contextos",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "Contextos"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-ERJ-spYt.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/meetOverlay.ts-BVgfMdHB.js"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "alarms",
    "identity"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "88",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/index.ts-ERJ-spYt.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*"
      ],
      "resources": [
        "assets/meetOverlay.ts-BVgfMdHB.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
