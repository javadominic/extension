{
  "manifest_version": 3,
  "name": "Contextos",
  "version": "1.1.0",
  "description": "Smart bookmark memory assistant with AI. Save why you bookmarked something and never forget again.",
  "author": "Your Name",
  "homepage_url": "https://github.com/yourusername/contextos",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "Contextos"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-CPE87-g9.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/searchSuggest.ts-DH_xQ0eO.js"
      ],
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*",
        "https://www.google.co.in/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.ca/search*",
        "https://www.google.com.au/search*",
        "https://www.google.de/search*",
        "https://www.google.fr/search*",
        "https://www.google.co.jp/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*",
        "https://search.brave.com/search*",
        "https://search.opera.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/meetOverlay.ts-BVgfMdHB.js"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "alarms",
    "identity"
  ],
  "oauth2": {
    "client_id": "367359110826-3vd2pbhb9703s5m70mbhg6uln5rklfa2.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "88",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/index.ts-CPE87-g9.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://duckduckgo.com/*",
        "https://google.com/*",
        "https://search.brave.com/*",
        "https://search.opera.com/*",
        "https://www.bing.com/*",
        "https://www.google.ca/*",
        "https://www.google.co.in/*",
        "https://www.google.co.jp/*",
        "https://www.google.co.uk/*",
        "https://www.google.com.au/*",
        "https://www.google.com/*",
        "https://www.google.de/*",
        "https://www.google.fr/*"
      ],
      "resources": [
        "assets/searchSuggest.ts-DH_xQ0eO.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*"
      ],
      "resources": [
        "assets/meetOverlay.ts-BVgfMdHB.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
